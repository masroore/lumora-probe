              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sequence"
        },
        "severity": {
          "$ref": "#/$defs/EventSeverity",
          "default": "info"
        }

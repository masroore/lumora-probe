            "observed",
            "client-asserted"
          ],
          "title": "EventOrigin",
          "type": "string"
        },
        "EventSeverity": {
          "description": "Operator-facing event severity.",
          "enum": [
            "debug",
            "info",
            "warning",
            "error",
            "critical"
          ],
          "title": "EventSeverity",
          "type": "string"
        }
      },

        },
        "causation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Causation Id"
        },
        "correlation_id": {
          "title": "Correlation Id",
          "type": "string"
        },
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "event_name": {
          "title": "Event Name",
          "type": "string"
        },
        "event_version": {
          "minimum": 1,
          "title": "Event Version",
          "type": "integer"
        },
        "monotonic_ns": {
          "minimum": 0,
          "title": "Monotonic Ns",
          "type": "integer"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "origin": {

{
  "components": {
    "schemas": {
      "ClientEventRequest": {
        "additionalProperties": false,
        "description": "Client-supplied fields; producer and origin are intentionally absent.",
        "properties": {
          "aggregate_id": {
            "title": "Aggregate Id",
            "type": "string"
          },
          "aggregate_type": {
            "default": "Viewer",
            "title": "Aggregate Type",
            "type": "string"
          },
          "correlation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Correlation Id"
          },
          "event_name": {
            "title": "Event Name",
            "type": "string"
          },
          "event_version": {
            "minimum": 1.0,
            "title": "Event Version",
            "type": "integer"
          },
          "payload": {
            "additionalProperties": true,
            "title": "Payload",
            "type": "object"
          },
          "severity": {
            "$ref": "#/components/schemas/EventSeverity",
            "default": "info"
          }
        },
        "required": [
          "event_name",
          "event_version",
          "aggregate_id",
          "payload"
        ],
        "title": "ClientEventRequest",
        "type": "object"
      },
      "EventSeverity": {
        "description": "Operator-facing event severity.",
        "enum": [
          "debug",
          "info",
          "warning",
          "error",
          "critical"
        ],
        "title": "EventSeverity",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
